PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase credentials — server-side only, never expose to the frontend.
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key-here

# Legacy alias (either variable name is accepted):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Google OAuth 2.0 — server-side only, never expose to the frontend.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
# The redirect URI must EXACTLY match one registered on that OAuth client.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Frontend origin the OAuth callback redirects back to after connecting.
FRONTEND_URL=http://localhost:5173

# Signs the session cookie and the CSRF hash for OAuth flows. Required in Phase 3A.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-char-hex-string

# AES-256-GCM key for encrypting OAuth tokens at rest. Must be exactly 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER log, commit, or send this value anywhere outside backend/.env.
TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-string
